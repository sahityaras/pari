    <dc:title>परी</dc:title>
    <dc:language>ne</dc:language>
    <dc:creator id="creator">लक्ष्मीप्रसाद देवकोटा</dc:creator>
    <dc:date>2026-11-24T00:29:48Z</dc:date>
    <dc:publisher>Sahityaras</dc:publisher>
    <meta name="source_publisher" content="नइ प्रकाशन"></meta>
    <meta name="source_edition" content="पहिलो"></meta>
    <meta name="source_year" content="२०६६"></meta>
    <meta name="source_isbn" content="978-9937-509-14-5"></meta>
    <meta name="book_about" content="महाकवि लक्ष्मीप्रसाद देवकोटाको परी कवितासङ्ग्रहका सिर्जनाहरू रुमानी वा स्वच्छन्दतावादी कविताधाराको प्रकृतिकेन्द्री र रहस्यवादी जीवनदृष्टिमा गहिरो रूपमा उभिएका छन् । जीवनका हाँसो, आँसु, सपना, बिपना, क्षणिकता, तृष्णा र धैर्यदेखि लिएर प्रकृतिका विविध रूप, समयचक्र, आध्यात्मिकता र प्रकृतिपरक देशभक्तिसम्मका बहुआयामिक भावहरूलाई यस सङ्ग्रहका कविताहरूले स्वस्फूर्त कल्पना, मोहक बिम्ब र सौन्दर्यबोधका माध्यमबाट उजागर गरेका छन् । आफ्ना उत्तरवर्ती सिर्जनाहरूमा देखिने नेपालीकृत र स्वायत्तीकृत स्वच्छन्दतावादी रूपको तुलनामा यहाँ देवकोटामा अङ्ग्रेजीका साथै बङ्गाली, अरबी-फारसी र हिन्दी साहित्यका रुमानी, रहस्यवादी तथा छायावादी धाराबाट प्राप्त प्रभाव र प्रेरणाको स्पष्ट झलक पाइन्छ ।"></meta>
    <meta name="book_genre" content="कवितासङ्ग्रह"></meta>
    <meta name="book_slug" content="pari"></meta>
    <meta name="cover" content="cover-img"></meta>
